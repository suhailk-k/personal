# Copy to .env.local for local development.
#
# Base URL of the backend described in docs/api-contract.md. No trailing slash.
#
# NEXT_PUBLIC_ values are compiled into the client bundle and readable by
# anyone who loads the site. Never put a secret here. For the deployed build,
# set this as a repository *variable* under
# Settings > Secrets and variables > Actions > Variables.
NEXT_PUBLIC_API_URL=http://localhost:4000
