# Backend URL for production builds, including the GitHub Pages deploy.
#
# Committed on purpose. NEXT_PUBLIC_ values are compiled into the client bundle
# and readable by anyone who loads the site, so this is public either way —
# keeping it here makes the deployed build reproducible instead of depending on
# a repository variable somebody has to remember to set.
#
# Never put a secret in a NEXT_PUBLIC_ variable.
#
# The repository variable still wins when it is set (see .github/workflows/
# nextjs.yml), so pointing a deploy somewhere else needs no commit.
NEXT_PUBLIC_API_URL=https://plausible-borrower-manicotti.ngrok-free.dev
